# Variables de entorno para la configuración de la base de datos, puertos y credenciales.
MYSQL_ROOT_PASSWORD=root_pass_dev
MYSQL_DATABASE=turnoya
MYSQL_USER=turnoya_user
MYSQL_PASSWORD=turnoya_pass

# Puertos expuestos en el host (podes cambiarlos si ya estan ocupados).
MYSQL_PORT=3306
PHPMYADMIN_PORT=8081
BACKEND_PORT=8080
FRONTEND_PORT=8082

# Seguridad del backend (JWT) y credenciales del super administrador inicial.
# IMPORTANTE: cambiar estos valores en cualquier entorno real.
APP_TIME_ZONE=America/Argentina/Buenos_Aires
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-1234567890abcdef
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=CambiarPassword123
SUPERADMIN_CORREO=superadmin@turnoya.local
